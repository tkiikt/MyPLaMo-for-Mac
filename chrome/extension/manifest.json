{
  "action": {
    "default_title": "MyPLaMo 翻訳メニュー",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/myplamo-16.png",
      "24": "icons/myplamo-24.png",
      "32": "icons/myplamo-32.png",
      "48": "icons/myplamo-48.png",
      "64": "icons/myplamo-64.png"
    }
  },
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "alarms"
  ],
  "description": "Windows版MyPLaMo / MyPLaMo for Macで、選択文をポップアップ翻訳・コピー。ページ全体の日本語翻訳にも対応。Built with PLaMo",
  "background": {
    "service_worker": "worker.js"
  },
  "name": "MyPLaMo ページ翻訳",
  "key": "",
  "version": "2.3.6",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      }
    }
  },
  "minimum_chrome_version": "116",
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/myplamo-16.png",
    "24": "icons/myplamo-24.png",
    "32": "icons/myplamo-32.png",
    "48": "icons/myplamo-48.png",
    "64": "icons/myplamo-64.png",
    "128": "icons/myplamo-128.png",
    "256": "icons/myplamo-256.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "settings.js",
        "selection.js",
        "bootstrap.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
